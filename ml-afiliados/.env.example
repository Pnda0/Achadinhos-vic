# ============================================================
#  ml-afiliados — copie este arquivo para ".env" e preencha
# ============================================================

# --- Mercado Livre Afiliados -------------------------------
# Sua etiqueta (tag). Central de Afiliados > "Administrar etiquetas".
ML_AFFILIATE_TAG=

# Login do ML: rode "npm run login-ml" (abre o navegador, você faz login e o bot guarda a sessão).
# Só preencha ML_COOKIES se preferir o jeito manual do curso (F12) — veja o README.
ML_COOKIES=

# Opcional: token x-csrf-token. O bot tenta descobrir sozinho; só preencha se ele pedir.
ML_CSRF_TOKEN=

# --- WhatsApp ----------------------------------------------
# Como enviar: "wwebjs" (whatsapp-web.js, QR code no terminal),
#              "evolution" (Evolution API), "wuzapi" (WuzAPI) ou "console" (só mostra na tela — modo teste)
SENDER=console

# Evolution API (se SENDER=evolution)
EVOLUTION_URL=http://localhost:8080
EVOLUTION_INSTANCE=
EVOLUTION_APIKEY=

# WuzAPI (se SENDER=wuzapi)
WUZAPI_URL=http://localhost:8080
WUZAPI_TOKEN=

# (wwebjs) Mostrar a janela do WhatsApp Web? true = janela visível (mais fácil de escanear o QR e de ver problemas)
WHATSAPP_JANELA=true

# Caminho do Chrome/Edge — só preencha se o bot disser que não encontrou o navegador
CHROME_PATH=

# Se o WhatsApp recusar o upload da imagem mesmo depois de 3 tentativas, mandar só o texto com o link?
ENVIAR_SEM_IMAGEM=true

# Simular "digitando..." antes de cada envio (como no curso)
SIMULAR_DIGITANDO=true

# --- Títulos com IA (opcional) -----------------------------
# Qualquer API compatível com OpenAI: Groq, OpenRouter, OpenAI, Gemini (endpoint OpenAI).
# Deixe LLM_API_KEY vazio para usar os títulos prontos (sem IA).
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile

# --- Agenda (formato cron) ---------------------------------
CRON_COLETA=0 7,12,17 * * *
CRON_ENVIO=*/8 8-21 * * *
CRON_LIMPEZA=0 0 * * *
CRON_RESUMO=58 21 * * *
TZ=America/Sao_Paulo

# --- Monitoramento externo: ser avisado se o bot CAIR ---------------------------------
# O bot não consegue avisar depois de morto. Crie um check em https://healthchecks.io
# (ou "heartbeat monitor" no UptimeRobot / Better Stack), período 5 min, e cole a URL
# aqui. O bot faz um GET nela a cada CRON_HEARTBEAT; se os pings pararem (processo caiu,
# deploy quebrou, Render fora do ar), o serviço te avisa por e-mail/Telegram.
HEARTBEAT_URL=
CRON_HEARTBEAT=*/5 * * * *

# --- Avisos e resumo diário no SEU WhatsApp -------------------------------------------
# Nome de um grupo (recomendado: crie "Avisos do bot" só com você e o número do bot)
# ou seu número com 55 + DDD, só dígitos (ex.: 5579999998888). Vazio = avisos só no log.
AVISOS_DESTINO=

# --- Amazon (API oficial: Creators API) -------------------------------------------
# Associates Central > Ferramentas > Creators API > Create Application > Add New Credential.
# O Secret aparece UMA vez só: copie direto para cá. A Amazon só libera a API com vendas recentes.
AMAZON_CREDENTIAL_ID=
AMAZON_CREDENTIAL_SECRET=
AMAZON_PARTNER_TAG=
AMAZON_MARKETPLACE=www.amazon.com.br

# --- Awin (outras lojas: adidas, Centauro, Granado...) ------------------------------
# Token da API: https://ui.awin.com/awin-api > Create token. Com ele o bot lê as lojas em que a conta
# foi aprovada, os cupons delas e gera os links. Lojas e grupos: config/awin.json. Teste: npm run awin
AWIN_API_TOKEN=
# Opcional: seu id de afiliado (publisher). Com o token o bot descobre sozinho.
AWIN_PUBLISHER_ID=

# --- Telegram (para testar sem WhatsApp) --------------------------------------------
# SENDER=telegram ; token do @BotFather ; o chat id de cada grupo vai em config/grupos.json ("telegram").
TELEGRAM_BOT_TOKEN=
# Onde chegam alertas/resumo no Telegram: chat id da sua conversa privada com o bot (ou de um grupo).
# Essa conversa também é a caixa de entrada: mande nela um link da Amazon ou do ML e o bot posta com o seu link.
AVISOS_DESTINO_TELEGRAM=

# Painel de números no Cloudflare (README 3.15). Token só com "Cloudflare Pages: Editar". Sem eles, o painel fica só no PC.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Espelho no WhatsApp: o que sai no Telegram vai também para os grupos do WhatsApp (chip só do bot), devagar.
WHATSAPP_ESPELHO=false
WHATSAPP_INTERVALO_MIN=6
